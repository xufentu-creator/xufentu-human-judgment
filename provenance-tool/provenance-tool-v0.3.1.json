{
  "tool_name": "Provenance Tool",
  "tool_version": "0.3.1",
  "release_status": "public",
  "release_date": "2026-07-01",
  "tool_type": "browser-based provenance workspace",
  "concept_and_authorship": {
    "name": "Xufen Tu",
    "role": "Independent Interdisciplinary Researcher"
  },
  "description": {
    "en": "A local browser-based workspace for creating, verifying, and comparing portable provenance records for documents, source files, media, archives, and project folders.",
    "zh-CN": "一个用于为文档、源代码、媒体文件、压缩文件和项目文件夹创建、验证并比较可携带溯源记录的浏览器本地工作台。"
  },
  "public_access": "https://xufentu.com/provenance-tool/",
  "canonical_repository": "https://github.com/xufentu-creator/xufentu-human-judgment",
  "public_identity_anchor": "TUX-133.144~",
  "working_modes": [
    {
      "id": "create",
      "name": {
        "en": "Create Record",
        "zh-CN": "创建记录"
      },
      "description": {
        "en": "Generate one portable provenance ZIP package with structured records and SHA-256 integrity values.",
        "zh-CN": "生成一个包含结构化记录和 SHA-256 完整性值的可携带溯源 ZIP 记录包。"
      }
    },
    {
      "id": "verify",
      "name": {
        "en": "Verify Record",
        "zh-CN": "验证记录"
      },
      "description": {
        "en": "Check current files against a previously saved provenance package or integrity record.",
        "zh-CN": "将当前文件与以前保存的溯源记录包或完整性记录进行核对。"
      }
    },
    {
      "id": "compare",
      "name": {
        "en": "Compare Versions",
        "zh-CN": "前后对比"
      },
      "description": {
        "en": "Identify unchanged, changed, added, and removed files between two versions.",
        "zh-CN": "识别两个版本之间未变化、已修改、新增和删除的文件。"
      }
    }
  ],
  "supported_content": [
    "documents",
    "source-code files",
    "images",
    "audio files",
    "video files",
    "datasets",
    "compressed archives",
    "project folders",
    "binary files"
  ],
  "record_classifications": [
    "Public",
    "Internal",
    "Confidential",
    "Restricted"
  ],
  "processing": {
    "location": "local browser",
    "automatic_file_upload": false,
    "integrity_algorithm": "SHA-256"
  },
  "generated_package": {
    "format": "ZIP",
    "single_download": true,
    "possible_contents": [
      "metadata.json",
      "provenance.json",
      "file-integrity-records.json",
      "release-manifest.json",
      "citation.txt",
      "README.md"
    ]
  },
  "verification_results": [
    "Unchanged",
    "Changed",
    "Added",
    "Removed"
  ],
  "public_record_behavior": {
    "suggested_citation_available": true,
    "official_link_optional": true
  },
  "private_record_behavior": {
    "suggested_citation_hidden_by_default": true,
    "record_summary_available": true
  },
  "interface_languages": [
    "English",
    "简体中文"
  ],
  "boundary": {
    "supports": [
      "basic provenance documentation",
      "version continuity",
      "file integrity records",
      "record verification",
      "version comparison",
      "portable project archiving",
      "citation continuity for public records"
    ],
    "does_not": [
      "prove originality",
      "determine legal ownership",
      "verify the truth of content",
      "detect plagiarism",
      "identify whether content was generated by AI",
      "resolve authorship disputes",
      "create copyright registration",
      "provide an independently trusted timestamp",
      "replace human judgment"
    ]
  },
  "privacy_notice": {
    "en": "Selected files are processed locally in the browser and are not automatically uploaded to the website server.",
    "zh-CN": "所选择的文件在浏览器本地处理，不会自动上传到网站服务器。"
  },
  "responsibility_statement": {
    "en": "Automation can support structure, but responsibility remains visible.",
    "zh-CN": "自动化可以支持结构，但责任必须保持可见。"
  }
}
